# Copy to .env and fill in. Only VITE_* variables reach the browser bundle,
# so never put secrets (client secrets, API keys, tokens) in this file.

# Base URL of a future backend API. Leave empty to run on demo fixtures.
VITE_API_URL=

# Public OAuth client IDs for optional calendar integration.
# The matching client SECRETS must stay on a server, never here.
VITE_GOOGLE_CALENDAR_CLIENT_ID=
VITE_OUTLOOK_CLIENT_ID=
